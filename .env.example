# Copy to .env and fill in. Never commit .env.

# FalkorDB (local Docker by default; FalkorDB Cloud for the live deployment)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_NAME=shaky

# Data sources
OPENALEX_API_KEY=
S2_API_KEY=

# LLM providers (OpenAI-compatible endpoints, free tiers)
GEMINI_API_KEY=
GROQ_API_KEY=

# 1 = the web UI and MCP server may run foundation checks (spends credits and model calls); 0 = read only
ALLOW_RUNS=1
